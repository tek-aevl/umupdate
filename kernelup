#!/bin/bash
#reset terminal
reset
# Cache sudo
sudo -v

# Ensure script is run with root/sudo privileges
if [ "$EUID" -ne 0 ]; then
    echo "--------------------------------------------------------"
    echo "[-] Please run this script with sudo: sudo kernelup"
    echo "[-] Or run it directly from remote via:"
    echo "    rm -f /tmp/kernelup && curl -sSL https://raw.githubusercontent.com/tek-aevl/umupdate/refs/heads/main/kernelup -o /tmp/kernelup && sudo bash /tmp/kernelup"    
    echo "--------------------------------------------------------"
    exit 1
fi

# ==========================================
# INTERACTIVE KERNEL MENU FUNCTION
# ==========================================
interactive_kernel_menu() {
    echo "--------------------------------------------------------"
    echo "[+] Fetching available kernels for interactive menu..."
    
    # Read the top 10 kernels into an array
    mapfile -t KERNELS < <(mainline list | grep -E '^[0-9]' | head -n 10 | awk '{print $1}')
    
    # Add extra management options to the bottom of the list
    OPTIONS=("${KERNELS[@]}" "Restore Default Ubuntu Kernel (OEM/Generic)" "Cancel / Exit Menu")
    
    echo "--------------------------------------------------------"
    PS3="Select an option (1-${#OPTIONS[@]}): "
    select choice in "${OPTIONS[@]}"; do
        if [[ "$choice" == "Cancel / Exit Menu" ]]; then
            echo "[-] Exiting kernel menu."
            break
        elif [[ "$choice" == "Restore Default Ubuntu Kernel (OEM/Generic)" ]]; then
            echo "[+] Restoring standard Ubuntu generic kernel via apt..."
            apt update
            apt install --install-recommends linux-generic linux-headers-generic -y
            CHANGES_MADE=true
            break
        elif [[ -n "$choice" ]]; then
            echo "[+] Installing kernel version: $choice"
            mainline install "$choice"
            CHANGES_MADE=true
            break
        else
            echo "[-] Invalid selection. Please pick a valid number."
        fi
    done
    echo "--------------------------------------------------------"
}
# ==========================================

# Check if an older version exists, and back it up if it does
if [ -f "/usr/local/bin/kernelup" ]; then
    echo "[*] Existing installation found. Backing up to kernelup.sh..."
    sudo mv /usr/local/bin/kernelup /usr/local/bin/kernelup.sh
fi

echo "[+] Downloading latest kernelup from GitHub..."
curl -sSL https://raw.githubusercontent.com/tek-aevl/umupdate/refs/heads/main/kernelup -o /usr/local/bin/kernelup

if [ $? -eq 0 ]; then
    sudo chmod +x /usr/local/bin/kernelup
    echo "[+] Successfully installed!"
    echo "--------------------------------------------------------"
    echo "[-] Please run this script with sudo: sudo kernelup"
    echo "[-] Or run it directly from remote via:"
    echo "    rm -f /tmp/kernelup && curl -sSL https://raw.githubusercontent.com/tek-aevl/umupdate/refs/heads/main/kernelup -o /tmp/kernelup && sudo bash /tmp/kernelup"    
    echo "--------------------------------------------------------"
else
    echo "[-] Download failed. Please check your URL or repository visibility."
    exit 1
fi

# 1. Verify if 'mainline' is installed
if ! command -v mainline &> /dev/null; then
    echo "[!] The 'mainline' utility is not installed."
    read -p "Would you like to install it now? (y/N) " -n 1 -r
    echo
    if [[ -z \(REPLY ]] || [[\)REPLY =~ ^[Yy] ]]; then
        echo "[+] Adding PPA and installing mainline..."
        add-apt-repository ppa:cappelikan/ppa -y
        apt update
        apt install mainline -y
    else
        echo "[-] Mainline is required to run this tool. Exiting."
        exit 1
    fi
fi

# 2. Capture current running kernel and list installed kernels
CURRENT_KERNEL=$(uname -r)
echo "--------------------------------------------------------"
echo "[*] Current Running Kernel : $CURRENT_KERNEL"
echo "--------------------------------------------------------"
echo "[+] Installed Stock Ubuntu Kernels (OEM):"
# dpkg-query is safer than dpkg -l because it never truncates text on small screens
dpkg-query -W -f='${Package}\n' | grep -E '^linux-image-[0-9]' | grep -v 'unsigned' | sed 's/linux-image-//' | sed 's/^/    /'
echo "--------------------------------------------------------"
echo "[+] Installed Mainline Kernels:"
# Store the output first so the 'sed' pipe doesn't mask the exit code of grep
MAINLINE_INSTALLED=$(mainline list-installed | grep -E '^[0-9]')
if [ -n "$MAINLINE_INSTALLED" ]; then
    echo "$MAINLINE_INSTALLED" | sed 's/^/    /'
else
    echo "    (No mainline kernels installed yet)"
fi
echo "--------------------------------------------------------"

# 3. Show top available kernels
echo "[+] Top 5 Available Mainline Kernels:"
echo "--------------------------------------------------------"
mainline list | grep -E '^[0-9]' | head -n 5
echo "--------------------------------------------------------"

# Capture the absolute latest version available upstream
LATEST_AVAILABLE=$(mainline list | grep -E '^[0-9]' | head -n 1 | awk '{print $1}')

# Track if we actually install anything so we know whether to prompt for reboot
CHANGES_MADE=false

# 4. Prompt to install the latest (Defaults to YES on Enter)
read -p "Install the latest kernel ($LATEST_AVAILABLE)? (Y/n) " -n 1 -r
echo
if [[ -z $REPLY ]] || [[ $REPLY =~ ^[Yy] ]]; then
echo "[+] Installing the latest mainline kernel ($LATEST_AVAILABLE)..."
    mainline install-latest
    CHANGES_MADE=true
else
    # User said No, launch the interactive menu
    interactive_kernel_menu
fi

# 5. Cleanup unused kernels
echo "[+] Cleaning up old unused mainline kernels (keeping active kernel safe)..."
mainline uninstall-old

echo "--------------------------------------------------------"
echo "[+] Kernel update & cleanup complete."
echo "--------------------------------------------------------"

# 6. Only prompt for reboot if a new kernel was actually installed
bash <(curl -s https://raw.githubusercontent.com/tek-aevl/umupdate/refs/heads/main/kernel-check)
if [ "$CHANGES_MADE" = true ]; then
    read -p "A new kernel was installed. Do you want to reboot now? (y/N) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy] ]]; then
        echo "[+] Rebooting system..."
        reboot
    else
        echo "[!] Remember to reboot later for the changes to take effect."
    fi
else
    echo "[*] No new kernel was installed. System is ready."
fi
