#!/bin/bash
#reset terminal
reset
# Cache sudo
sudo -v

# Ensure script is run with root/sudo privileges
if [ "$EUID" -ne 0 ]; then
    echo "--------------------------------------------------------"
    echo "[-] Please run this script with sudo: sudo kernelup"
    echo "[-] Or run it directly from remote via:"
    echo "
sudo rm /tmp/kernelup && curl -sSL https://raw.githubusercontent.com/tek-aevl/umupdate/refs/heads/main/kernelup -o /tmp/kernelup && sudo bash /tmp/kernelup
"    
    echo "--------------------------------------------------------"
    exit 1
fi

# ==========================================
# INTERACTIVE KERNEL MENU FUNCTION
# ==========================================
interactive_kernel_menu() {
    echo "--------------------------------------------------------"
    echo "[+] Fetching available kernels for interactive menu..."
    
    # Read the top 10 kernels into an array
    mapfile -t KERNELS < <(mainline list | grep -E '^[0-9]' | head -n 10 | awk '{print $1}')
    
    # Add extra management options to the bottom of the list
    OPTIONS=("${KERNELS[@]}" "Uninstall Old Kernels (Cleanup)" "Cancel / Exit Menu")
    
    echo "--------------------------------------------------------"
    PS3="Select an option (1-${#OPTIONS[@]}): "
    select choice in "${OPTIONS[@]}"; do
        if [[ "$choice" == "Cancel / Exit Menu" ]]; then
            echo "[-] Exiting kernel menu."
            break
        elif [[ "$choice" == "Uninstall Old Kernels (Cleanup)" ]]; then
            echo "[+] Uninstalling old kernels..."
            mainline uninstall-old
            break
        elif [[ -n "$choice" ]]; then
            echo "[+] Installing kernel version: $choice"
            mainline install "$choice"
            break
        else
            echo "[-] Invalid selection. Please pick a valid number."
        fi
    done
    echo "--------------------------------------------------------"
}
# ==========================================

# Check if an older version exists, and back it up if it does
if [ -f "/usr/local/bin/kernelup" ]; then
    echo "[*] Existing installation found. Backing up to kernelup.sh..."
    sudo mv /usr/local/bin/kernelup /usr/local/bin/kernelup.sh
fi

echo "[+] Downloading latest kernelup from GitHub..."
curl -sSL https://raw.githubusercontent.com/tek-aevl/umupdate/refs/heads/main/kernelup -o /usr/local/bin/kernelup

if [ $? -eq 0 ]; then
    sudo chmod +x /usr/local/bin/kernelup
    echo "[+] Successfully installed! You can now run: sudo kernelup"
else
    echo "[-] Download failed. Please check your URL or repository visibility."
    # Optional: You could restore the backup here if the download fails
    # sudo mv /usr/local/bin/kernelup.sh /usr/local/bin/kernelup
    exit 1
fi

# 1. Verify if 'mainline' is installed
if ! command -v mainline &> /dev/null; then
    echo "[!] The 'mainline' utility is not installed."
    read -p "Would you like to install it now? (y/N) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy] ]]; then
        echo "[+] Adding PPA and installing mainline..."
        add-apt-repository ppa:cappelikan/ppa -y
        apt update
        apt install mainline -y
    else
        echo "[-] Mainline is required to run this tool. Exiting."
        exit 1
    fi
fi

# 2. Capture current running kernel
CURRENT_KERNEL=$(uname -r)
echo "--------------------------------------------------------"
echo "[*] Current Running Kernel : $CURRENT_KERNEL"
echo "--------------------------------------------------------"

# 3. Show top 5 available mainline kernels (filtered to show only version numbers)
echo "[+] Top 5 Available Mainline Kernels:"
echo "--------------------------------------------------------"
mainline list | grep -E '^[0-9]' | head -n 5
echo "--------------------------------------------------------"

echo "[+] Checking for updates and installing the latest mainline kernel..."
# Capture output to check if an update actually happened
INSTALL_OUTPUT=$(mainline install-latest 2>&1)
echo "$INSTALL_OUTPUT"

# 4. Check if changes were made
NEW_KERNEL_CHECK=$(uname -r)

echo "--------------------------------------------------------"
echo "[+] Kernel update check complete."
echo "[*] Previous Kernel : $CURRENT_KERNEL"
echo "[*] Active Kernel Now: $NEW_KERNEL_CHECK"
echo "--------------------------------------------------------"

# 5. Handle Reboot & Interactive Prompts
if echo "$INSTALL_OUTPUT" | grep -q "No updates"; then
    echo "[*] Your system is already running the latest mainline kernel. No reboot needed."
    
    read -p "Do you want to manage/change kernels manually? (y/N) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy] ]]; then
        interactive_kernel_menu
        
        read -p "Do you want to reboot now? (y/N) " -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy] ]]; then
            echo "[+] Rebooting system..."
            reboot
        fi
    fi
else
    read -p "Do you want to manage/change kernels manually? (y/N) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy] ]]; then
        interactive_kernel_menu
    fi

    read -p "A new kernel was installed. Do you want to reboot now? (y/N) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy] ]]; then
        echo "[+] Rebooting system..."
        reboot
    else
        echo "[!] Remember to reboot later for the changes to take effect."
    fi
fi
