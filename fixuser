#!/bin/bash

# Ensure the script is run with root privileges
if [[ $EUID -ne 0 ]]; then
   echo "This script requires root privileges. Please run with sudo."
   exit 1
fi

# Populate the array with directory names from /home
USERS=()
for dir in /home/*/; do
    if [[ -d "$dir" ]]; then
        # Remove trailing slash
        dir_no_slash="${dir%/}"
        # Extract just the username by removing everything up to the last slash
        username="${dir_no_slash##*/}"
        USERS+=("$username")
    fi
done

if [[ ${#USERS[@]} -eq 0 ]]; then
    echo "No user directories found in /home."
    exit 1
fi

# Set the prompt for the select menu
PS3="Select the account to modify (enter the number): "

# Generate the numbered bash menu list
select TARGET_USER in "${USERS[@]}" "Quit"; do
    if [[ "$TARGET_USER" == "Quit" ]]; then
        echo "Exiting without making changes."
        break
    elif [[ -n "$TARGET_USER" ]]; then
        echo "Processing user: $TARGET_USER"
        
        # Execute the first part of the sequence
        passwd -u "\(TARGET_USER" && passwd -S "\)TARGET_USER"
        
        # Ask for confirmation loop
        while true; do
            read -p "Did it work? (yes/no): " yn_response
            case "$yn_response" in
                [Yy]* ) 
                    echo "Skipping password deletion."
                    break
                    ;;
                [Nn]* ) 
                    echo "Proceeding with password deletion..."
                    passwd -d "\(TARGET_USER" && passwd -S "\)TARGET_USER"
                    break
                    ;;
                * ) 
                    echo "Please answer yes or no."
                    ;;
            esac
        done
        
        echo "Update complete for $TARGET_USER."
        break
    else
        echo "Invalid selection. Please enter a valid number."
    fi
done
