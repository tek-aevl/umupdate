#!/bin/bash
version="1.3.26"
UPDATE_URL="https://raw.githubusercontent.com/tek-aevl/umupdate/refs/heads/main/update"
echo
#config
qdel='5'

echo
# ==========================================
# 1. SELF-UPDATE CHECK
# ==========================================
echo "Hello $USER! #v$version#"
echo "Info at https://github.com/tek-aevl/umupdate/ #To use run # bash update or bash <(curl -s $UPDATE_URL)"

if [ -f "/bin/update" ]; then
    # Grab the exact version number from the variable declaration
    installed_version=$(grep -m 1 -oP '^\s*version="\K[^"]+' /bin/update)
    
    # Failsafe: If grep fails, avoid an infinite loop
    if [ -z "$installed_version" ]; then
        installed_version="UNKNOWN"
    fi

    echo "Installed Version is $installed_version"
    
    if [ "$installed_version" == "$version" ]; then
        echo "Version matches!"
    else
        echo "Version mismatch! Installed version: $installed_version"
        # -t 10 adds a 10 second timeout so it won't hang forever if unattended
        if read -t 10 -p "Do you want to update to the new version? (Y/n) [Installs in 10s]: " choice; then
            choice="${choice:-y}" # Default to yes
            
            if [[ "$choice" =~ ^[Yy]$ ]]; then
                echo "Backing up old version..."
                sudo mkdir -p /bin/update.old
                sudo mv /bin/update "/bin/update.old/$(date '+%Y%m%d%H%M%S').update"
                                                            
                updolds="/bin/update.old"
                #check if the directory exists
                if [ -d "$updolds" ]; then
                   # Get human-readable size for display
                   SIZE_HUMAN=$(sudo du -sh "$updolds" | awk '{print $1}')
                   # Get size in kilobytes for math comparison (10MB = 10240 KB)
                   SIZE_KB=$(sudo du -sk "$updolds" | awk '{print $1}')
                   # Show the size before offering anything
                   echo "The backup folder ($updolds) is currently using $SIZE_HUMAN of space."
                   # Count how many items are in the directory
                   ITEM_COUNT=$(ls -1A "$updolds" | wc -l)
                
                    # Check if the folder size is greater than (50 KB)
                    if [ "$SIZE_KB" -gt 50 ]; then
                        # Check if there are actually more than 2 versions to clean up
                        if [ "$ITEM_COUNT" -gt 2 ]; then
                            # Prompt the user for cleanup
                            read -t "$qdel" -p "The folder is over 50KB. Would you like to free up space by keeping only the latest TWO versions? (y/n): " choice
                            
                            case "$choice" in 
                                y|Y|yes|Yes ) 
                                    echo "Cleaning up older versions..."
                                    # Navigate to the directory, sort by time (newest first), skip the first TWO items, and remove the rest
                                    sudo bash -c "cd $updolds && ls -t | tail -n +3 | xargs rm -rf"
                                    
                                    NEW_SIZE=$(sudo du -sh "$updolds" | awk '{print $1}')
                                    echo "Cleanup complete! The folder is now using $NEW_SIZE of space."
                                    ;;
                                * )
                                    echo "Skipping cleanup."
                                    ;;
                            esac
                        else
                            echo "The folder is over 50KB, but only $ITEM_COUNT version(s) exist. Nothing to clean up."
                        fi
                    else
                        echo "The folder is under 50KB. No cleanup required."
                    fi
                else
                    echo "Directory $updolds does not exist."
                fi
            fi # <--  1: closes if [[ "$choice" =~ ^[Yy]$ ]]
        fi # <-- 2: closes if read -t 10...
    fi # <--  3: closes if [ "$installed_version" == "$version" ]

else
    echo "The file /bin/update does not exist."
    read -t "$qdel" -p "Do you want to install it? (Y/n): " choice
    choice="${choice:-y}" # Default to yes
    
    if [[ "$choice" =~ ^[Yy]$ ]]; then
        echo "Fetching the script from GitHub..."
        sudo curl -sL -o /bin/update "$UPDATE_URL"
        sudo chmod +x /bin/update
        
        if [ -f "/bin/update" ]; then
            echo "✅ Installed /bin/update successfully."
            sleep 2
            exec /bin/update 
        else
            echo "❌ Failed to install /bin/update."
        fi
    else
        echo "Installation cancelled."
    fi
fi
echo
HOST_IP=$(ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1); exit}')
user_info() {
    echo -e "${CYAN}$USER${NC}@${LIGHT_BLUE}$HOSTNAME${NC} (${YELLOW}$HOST_IP${NC})"
    uname -a
    uptime
}
user_info
echo
# ==========================================
# 2. GLOBAL VARIABLES & COLORS
# ==========================================
RED='\033[0;31m'
LIGHT_RED='\033[0;91m'
YELLOW='\033[0;33m'
LIGHT_YELLOW='\033[0;93m'
GREEN='\033[0;32m'
LIGHT_GREEN='\033[0;92m'
BLUE='\033[0;34m'
LIGHT_BLUE='\033[0;94m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[0;37m'
LIGHT_GRAY='\033[0;90m'
DARK_GRAY='\033[0;30m'
ORANGE='\033[0;33m' # Fallback for orange
NC='\033[0m'


# ==========================================
# 3. CORE FUNCTIONS
# ==========================================

run_fetch() {
    if command -v fastfetch &> /dev/null; then
        fastfetch
    elif command -v screenfetch &> /dev/null; then
        screenfetch
    else
        echo -e "${YELLOW}Neither fastfetch nor screenfetch is installed.${NC}"
    fi
}

display_profile_art() {  
    if command -v jp2a >/dev/null 2>&1; then
       curl -sL "https://tek.aevl.us/profile.jpg" -o /tmp/profile_ascii.jpg
       user_info
       jp2a --colors /tmp/profile_ascii.jpg
        
       rm -f /tmp/profile_ascii.jpg
    else
        echo "jp2a is not installed. To see the ASCII art, run: sudo apt install jp2a"
    fi
}

calculate_uptime() {
    current_timestamp=$(date +%s)
    uptime_raw=$(uptime -s)
    uptime_timestamp=$(date -d "$uptime_raw" +%s)
    time_difference=$((current_timestamp - uptime_timestamp))

    uptime_seconds=$(cut -d' ' -f1 /proc/uptime)
    uptime_seconds=$(printf "%.0f" "$uptime_seconds")
    days=$(echo "$uptime_seconds / 86400" | bc)
    hours=$(echo "$uptime_seconds % 86400 / 3600" | bc)
    minutes=$(echo "$uptime_seconds % 3600 / 60" | bc)
}

show_intro_and_art() {

    if command -v lolcat >/dev/null 2>&1; then
        display_profile_art | lolcat
    else
        display_profile_art
    fi

    echo -e "${GREEN}Welcome $USER@$HOSTNAME ($HOST_IP)${NC}"
    echo "$USER! this is update version $version#"
    user_info
    run_fetch
    if command -v inxi &> /dev/null; then inxi; fi
    
    echo "~${HOST_IP} who -a"
    echo -e "${YELLOW} Can you ${RED} sudo${NC}?"
    echo -e "${RED} Password $USER@$HOSTNAME ($HOST_IP) ${NC}"
    
    if sudo -v; then
        echo -e "${GREEN}sudo works.${NC}"
    else
        echo -e "${YELLOW}sudo password is required (or sudo not configured).${NC}"
    fi
    sudo who -a
    echo -e " ;-P ${NC} "

    echo "get-time $USER@$HOSTNAME ($HOST_IP)"
    calculate_uptime
    echo "do-math $USER@$HOSTNAME ($HOST_IP)"
    echo "uptime $USER@$HOSTNAME ($HOST_IP)"
    
    echo -e "${RED} Current Time variables : $days days, $hours hours, $minutes minutes ${NC}"
        sleep 2 
}

run_custom_scripts() {
    if [ -f /bin/kernelup ]; then
        echo -e "\nUpdating Kernel With kernelup"
        echo -e "${GREEN}Running kernelup...${NC}"
        rm -f /tmp/kernelup && curl -sSL https://raw.githubusercontent.com/tek-aevl/umupdate/refs/heads/main/kernelup -o /tmp/kernelup 
        sudo bash /tmp/kernelup && sudo cp /tmp/kernelup /bin/kernelup        
        echo "End of kernel up"
    fi
            if [ -f /bin/prune ] || command -v docker &> /dev/null || command -v podman &> /dev/null; then
                        # Prompt the user, defaulting to No on empty input or timeout
                        read -t 10 -p "Run prune? (y/N) [Skips in 10s]: " prune_resp
                        
                        # If the user explicitly types 'y' or 'Y', run it. Otherwise, skip it.
                        if [[ "$prune_resp" =~ ^[Yy]$ ]]; then
                            echo -e "\n${GREEN}Running prune...${NC}"
                            bash <(curl -s https://raw.githubusercontent.com/tek-aevl/umupdate/refs/heads/main/prune)
                            echo "Prune complete."
                        else
                            echo -e "\nSkipping prune."
                        fi
                    fi

    echo -e "\nRunning Custom Commands With customup"
    if [ ! -f /bin/customup ]; then
        if read -t 5 -r -p "/bin/customup not found. Create it now with nano? (y/N) [Skips in 5s]: " create_resp; then
            if [[ "$create_resp" =~ ^[Yy]$ ]]; then
                sudo nano /bin/customup
                if [ -f /bin/customup ]; then sudo chmod +x /bin/customup; fi
            else
                echo "Skipping customup."
            fi
        else
            echo -e "\nTimeout reached. Skipping customup."
        fi
    fi
    if [ -f /bin/customup ]; then
        echo -e "${GREEN}Running customup...${NC}"
        bash /bin/customup
        echo "End of customup"
    fi
}

update_packages() {
    update_command=""
    upgrade_command=""
    PKG_MANAGER=""

    if command -v pacman &> /dev/null; then
        PKG_MANAGER="pacman"
        update_command="sudo pacman -Syyu --noconfirm"
        upgrade_command="sudo pacman -Syyu --noconfirm"
    elif command -v apt &> /dev/null; then
        PKG_MANAGER="apt"
        update_command="sudo apt update"
        upgrade_command="sudo apt -o APT::Get::Always-Include-Phased-Updates=true upgrade -y"
    elif command -v dnf &> /dev/null; then
        PKG_MANAGER="dnf"
        update_command="sudo dnf check-update"
        upgrade_command="sudo dnf upgrade -y"
    elif command -v pkg &> /dev/null; then
        PKG_MANAGER="pkg"
        update_command="sudo pkg update"
        upgrade_command="sudo pkg upgrade -y"
    elif command -v zypper &> /dev/null; then
        PKG_MANAGER="zypper"
        update_command="sudo zypper refresh"
        upgrade_command="sudo zypper update -y"
    else
        echo "Unable to determine the package manager. Please update and upgrade manually."
        exit 1
    fi

    echo "Updating packages..."
    $update_command
    echo "Upgrading packages..."
    $upgrade_command

    if [[ "$PKG_MANAGER" == "apt" ]]; then
        sudo update-ca-certificates
        echo -e "${YELLOW}Autoremove${NC}"
        sudo apt autoremove -y
        echo -e "${CYAN}Fix broken updates${NC}"
        sudo dpkg --configure -a
        sudo apt --fix-broken install
        echo -e "${GREEN}Running apt autoremove...${NC}"
        sudo apt autoremove -y
    fi
    # Check and update Flatpak if installed
    if command -v flatpak &> /dev/null; then
        echo -e "${CYAN}Updating Flatpak packages...${NC}"
        flatpak update -y
        # Optional: remove unused flatpak runtimes
        # flatpak uninstall --unused -y 
    fi

    # Check and update Snap if installed
    if command -v snap &> /dev/null; then
        echo -e "${CYAN}Updating Snap packages...${NC}"
        sudo snap refresh
    fi
    echo -e " ${GREEN} Updates and Upgrades completed on ${HOST_IP}.${NC} "
}

update_rpi_firmware() {
    if command -v rpi-update &> /dev/null; then
        echo "sudo rpi-update"
        update_output=$(sudo SKIP_WARNING=1 rpi-update 2>&1)
        update_rc=$?
        echo "$update_output"

        if [[ $update_rc -ne 0 ]]; then
            echo -e "${RED}Firmware update failed.${NC}"
        elif echo "$update_output" | grep -qiE "already.*up.to.date|up.to.date"; then
            echo -e "${GREEN}Firmware already up to date. No reboot required.${NC}"
        else
            echo -e "${GREEN}Firmware update completed successfully.${NC}"
            read -p "Reboot now? (y/n): " reboot_now
            if [[ "$reboot_now" =~ ^([yY]|yes)$ ]]; then
                echo -e "${ORANGE}Firmware Changed.. Rebooting...${NC}"
                sudo reboot
            else
                echo -e "${RED}Firmware changed.. Reboot skipped...${NC}"
            fi
        fi
    fi
}

run_pihole_tasks() {
    waitfor=1
    if [[ "$days" -ge "$waitfor" ]]; then
        force_log_reset="yes"
        echo -e "${RED}System uptime: $days days, $hours hours, $minutes minutes ${NC}" 
    else
        force_log_reset="no"
        echo -e "${YELLOW}System uptime: $days days, $hours hours, $minutes minutes ${NC}" 
    fi

    if pihole -v &> /dev/null; then 
        echo -e "${GREEN}Pihole Updates!${NC}"
        echo "sudo pihole updatechecker" && sudo pihole updatechecker
        echo "sudo pihole networkflush" && sudo pihole networkflush
        echo "sudo pihole flush" && sudo pihole flush
        echo "sudo pihole reloaddns" && sudo pihole reloaddns 
        echo "sudo pihole updateGravity" && sudo pihole -g
        echo "reload list" && sudo pihole reloadlists
        echo "sudo pihole -up" && sudo pihole -up
        echo "complete"
        user_info
        echo -e "${CYAN} Automatically selected $force_log_reset ${NC}"
        echo -e "${RED}Reset logs anyway? ( $force_log_reset ) ${NC}"
        read -t "$qdel" -p "Force log reset? (y/n): " override

        if [[ -n $override ]]; then
            force_log_reset=$override
        else
            echo -e "${YELLOW}No input received. Using default value $force_log_reset .${NC}"
        fi

        if [[ "$force_log_reset" =~ ^[Yy]es$|^[Yy]$ ]]; then
            echo -e "${RED} $force_log_reset was selected.${NC}"
            echo -e "${YELLOW}Flushing Logs${NC}"
            echo "# output current pihole db size"
            sudo du -h /etc/pihole/pihole-FTL.db 2>/dev/null
            
            FILE="/tmp/pihole-FTL-old.db"
            if [[ -e "$FILE" ]]; then
                sudo du -h "$FILE"
            else
                sudo touch "$FILE"
                sudo du -h "$FILE"
            fi
            
            echo "# current old db size"
            sudo du -h /etc/pihole/pihole-FTL.db 2>/dev/null
            sudo du -h /etc/pihole/pihole-FTL-old.db 2>/dev/null
            sudo du -h /tmp/pihole-FTL-old.db 2>/dev/null
            
            echo "#pihole flush"
            sudo pihole flush
            
            echo "# Output pihole db size"
            sudo du -h /etc/pihole/pihole-FTL.db 2>/dev/null
            sudo du -h /etc/pihole/pihole-FTL-old.db 2>/dev/null
            sudo du -h /tmp/pihole-FTL-old.db 2>/dev/null
            sudo rm -f /tmp/pihole-FTL-old.db 
            sleep 3
            
            echo "# Stop pihole FTL service"
            sudo systemctl stop pihole-FTL
            sudo service pihole-FTL stop
            
            echo "moving current db to old db"
            sudo mv /etc/pihole/pihole-FTL-old.db /tmp/pihole-FTL-old.db 2>/dev/null
            sudo mv /etc/pihole/pihole-FTL.db /etc/pihole/pihole-FTL-old.db 2>/dev/null
            sudo service pihole-FTL start
            
            echo "# Start pihole FTL service"
            sudo systemctl start pihole-FTL
            
            echo "# Output reduced pihole db size"
            sudo du -h /etc/pihole/pihole-FTL.db 2>/dev/null
            sudo du -h /etc/pihole/pihole-FTL-old.db 2>/dev/null
            sudo du -h /tmp/pihole-FTL-old.db 2>/dev/null
            sleep 2
        else
            echo -e "The system has ${RED}not${NC} been running for longer than expected. ${GREEN}No db operations required.${NC}"
            echo -e "${GREEN}System uptime: $days days, $hours hours, $minutes minutes ${NC}" 
            sleep 4
        fi
           echo -e "\nEnd of Pi-Hole Tasks\n"
    fi
 }

run_kernel_check() {
    echo "###########################################################################################"
    echo "###############################   Running Kernel-Check   ##################################"
    echo "###########################################################################################"

    if command -v kernel-check &> /dev/null; then
        kernel-check 2>/dev/null
    elif [[ -f "kernel-check" ]]; then
        bash kernel-check 2>/dev/null
    else
        bash <(curl -fsSL "https://raw.githubusercontent.com/tek-aevl/umupdate/refs/heads/main/kernel-check") 2>/dev/null
    fi

    echo "^_^"
    echo "End of Kernel check"
    sleep 1
    user_info
}

handle_reboot_and_speedtest() {
    echo "############################################################################################"
    echo "######################################### uptime ###########################################"
    echo "############################################################################################"

    if [[ $uptime_seconds -ge $((3 * 24 * 3600)) ]]; then
        echo -e "${RED} The system has been running for longer than three days. ${NC}"  
        echo -e "${YELLOW} System uptime: $days days, $hours hours, $minutes minutes ${NC}"
        read -p "Would you like to reboot now? (Y/n): " choice
        if [[ "$choice" != [Nn]* ]]; then
            echo -e "${RED} Rebooting... $USER@$HOSTNAME ($HOST_IP) ${NC}"
            sudo reboot
            exit 0
        else
            echo -e "${RED} Reboot skipped. $USER@$HOSTNAME ($HOST_IP) ${NC} "
            sleep 3
        fi
    else
        echo -e "${GREEN} So good news! ${NC} $USER@$HOSTNAME ($HOST_IP)"   
        echo -e " The system has ${GREEN}not${NC} been running for longer than ${YELLOW}three${NC} days. ${YELLOW}No reboot required. ${NC}"
        echo -e "${GREEN} System uptime: $days days, $hours hours, $minutes minutes ${NC}"

        if command -v lolcat >/dev/null 2>&1; then
            display_profile_art | lolcat
        else
            display_profile_art
        fi
            
        user_info
        
        read -t "$qdel" -r -p "Run Speedtest? (y/N) [Skips in '${qdel}'s]: " response
        if [[ "$response" =~ ^[Yy]$ ]]; then
            user_info
            echo "Running speedtest"
            if ! command -v speedtest &> /dev/null && [ ! -f /bin/speedtest ]; then
                bash <(curl -fsSL "https://github.com/tek-aevl/umupdate/raw/refs/heads/main/speedtest.sh" -o /tmp/speedtest.sh)
                bash /tmp/speedtest.sh
            fi
            if command -v speedtest &> /dev/null || [ -f /bin/speedtest ]; then
                output=$(speedtest --secure 2>&1)
                if [[ "$output" == *"Unknown option"* ]] || [[ $? -ne 0 ]]; then
                    output=$(speedtest 2>&1)
                fi
                if command -v lolcat &> /dev/null; then
                    echo "$output" | lolcat
                else
                    echo "$output"
                fi
            else
                echo "Speedtest command still not found after running the script."
            fi
        else
            echo "Not running speedtest : System uptime: $(uptime)"
        fi

        user_info
        if read -t "$qdel" -p "Reboot Anyway? (y/N) [Skips in '${qdel}'s]: " choice; then
            if [[ "$choice" =~ ^[Yy]$ ]]; then
                echo -e "${RED} Rebooting... after 7 sec $USER@$HOSTNAME ($HOST_IP) ${NC}"
                run_fetch
                if command -v inxi &> /dev/null; then inxi; fi
                echo -e " ${RED} byah $USER@$HOSTNAME $HOST_IP ${NC} "
                echo "rebooting..."
                sleep 7
                sudo reboot
                exit 0
            else
                echo -e "${GREEN} Reboot Skipped. $USER@$HOSTNAME ($HOST_IP) ${NC}"
            fi
        else
            # This triggers if the timer runs out
            echo -e "\n${GREEN}Timeout reached. Reboot Skipped. $USER@$HOSTNAME ($HOST_IP) ${NC}"
        fi
    fi
}

close_out_script() {
    echo -e "\nRunning bash cclearer remotely..."
    echo -e "${GREEN}Running cclearer...${NC}"
    bash <(curl -fsSL "https://raw.githubusercontent.com/tek-aevl/umupdate/refs/heads/main/cclearer")
    echo "End of cclearer"
    echo
    user_info
    run_fetch
    if command -v inxi &> /dev/null; then inxi; fi
    users
    # Grab the current kernel values cleanly 
    CKRUNNING=$(uname -r)
    # Finding the newest installed kernel safely across OSs can be complex, fallback to listing string format requested
    CKNEWEST=${CKNEWEST:-"Unknown/Check manually"} 
    echo -e "Current Running kernel ($CKRUNNING) ; Current Installed kernel ($CKNEWEST)."
    echo -e "${GREEN} Byah.!. $USER@$HOSTNAME ($HOST_IP) ${NC}"
    exit 0
}

# ==========================================
# 4. MAIN EXECUTION FLOW
# ==========================================
show_intro_and_art
sleep 1
run_custom_scripts
sleep 1
update_packages
sleep 1
update_rpi_firmware
sleep 1
run_pihole_tasks
sleep 1
run_kernel_check
sleep 1
handle_reboot_and_speedtest
close_out_script
